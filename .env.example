# Any OpenAI-compatible chat-completions provider with JSON mode.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
APP_TIMEZONE=Europe/Moscow

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

LINEAR_API_KEY=
LINEAR_TEAM_ID=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/oauth/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/assistant.db
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- Film directory (TMDB) ---
# Optional: confirms a recommended title names a real film, so an invented one
# never reaches the user. Free key from https://www.themoviedb.org/settings/api
# Empty means recommendations still work, just unverified.
TMDB_API_KEY=

# --- Knowledge memory (Graphiti + Neo4j) ---
# Optional feature: with false the bot runs without long-term memory.
KNOWLEDGE_MEMORY_ENABLED=true
# Inside docker compose use bolt://neo4j:7687, from the host bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Graphiti falls back to LLM_* when these are empty: set them to use a cheaper model.
GRAPHITI_LLM_MODEL=
GRAPHITI_LLM_API_KEY=
GRAPHITI_LLM_BASE_URL=
# json_schema extracts noticeably better; switch to json_object for providers
# that only support {"type": "json_object"} response formats.
GRAPHITI_LLM_STRUCTURED_OUTPUT=json_schema
# The dimension must match the model (bge-m3: 1024, OpenAI
# text-embedding-3-small: 1536); changing either means rebuilding the graph.
GRAPHITI_EMBEDDING_MODEL=BAAI/bge-m3
GRAPHITI_EMBEDDING_DIM=1024
GRAPHITI_EMBEDDING_API_KEY=
GRAPHITI_EMBEDDING_BASE_URL=
# Concurrent Graphiti operations. Keep it low on small hosts: the default
# upstream fan-out of 20 needs far more memory than a 4 GB box can spare.
GRAPHITI_MAX_COROUTINES=4
